#!/bin/bash
BATTAPE_DB="${BATTAPE_DB:-"$HOME/.local/share/battape/battape.sqlite"}";

abort() {
  local code="$1";
  shift;
  echo "$*" >&2
  exit "$code";
}

__battape_tt_epoch() {
  if [ -z "$1" ]; then
    date +%s || exit "$?";
  elif [[ "$1" = *T* ]]; then
    date -j -f "%FT%T" "$1" +%s || exit "$?";
  elif [[ "$1" = *:* ]]; then
    date -j -f "%H:%M" "$1" +%s || exit "$?";
  elif [[ "$1" -ge 0 ]] 2>/dev/null; then
    echo "$1";
  else
    date -v 0H -v 0M -v 0S -v "${1:-"+0S"}" +%s || exit "$?";
  fi
}

__battape_tt_id() {
  LC_ALL=C tr -dc 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789' </dev/urandom | head -c 10;
}

# tt normalize_tags "f'oo,bar,baz,,foo,,,x,a,,," => ",a,bar,baz,foo,x,"
__battape_tt_normalize_tags() {
  [ -z "$1" ] || printf "%s" "$1" | tr -d "'" | tr ',[:space:]' '\n' | sort -u | awk 'NF { out = out "," $0 } END { print out "," }';
}

__battape_tt_query() {
  if [ "$1" = "-b" ]; then
    local sep="$2";
    shift 2;
    sqlite3 -batch -noheader -separator "$sep" "$BATTAPE_DB" "$@";
  elif [ -t 1 ]; then
    sqlite3 -header -column "$BATTAPE_DB" "$@";
  else
    sqlite3 "$BATTAPE_DB" "$@";
  fi
}

__battape_tt_drop() {
  local id answer quiet;
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) answer="yes"; shift ;;
      --quiet) quiet="$1"; shift ;;
      -*) abort 2 "ERR! Unknown option: $1" ;;
      *) id="$1"; shift ;;
    esac
  done

  [ -n "$id" ] || id="$(__battape_tt_query -b , "select id from time_tracker where end = 0 order by start desc limit 1")";

  local n; n="$(__battape_tt_query -b , "select count(*) from time_tracker where id = '${id//\'/\'\'}' limit 1")";
  [ "$n" -gt 0 ] || abort 0 "No such ID found.";
  [ -n "$quiet" ] || __battape_tt_report --no-footer --id "$id";
  [ -n "$answer" ] || read -r -p "Do you want to drop entry $id? [y/N] " answer;
  [[ "$answer" != y* ]] && [[ "$answer" != Y* ]] && return 0;
  __battape_tt_query "delete from time_tracker where id = '$id'";
}

__battape_tt_edit() {
  local id start end account description or_start add_tags delete_tags tags quiet;
  local has_start=0 has_end=0 has_account=0 has_description=0;

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -s|--start) start="$(__battape_tt_epoch "$2")"; has_start=1; shift 2 ;;
      -e|--end) end="$(__battape_tt_epoch "$2")"; has_end=1; shift 2 ;;
      -a|--account) account="$2"; has_account=1; shift 2 ;;
      -d|--description) description="$2"; has_description=1; shift 2 ;;
      -t|--tags) tags="$2"; shift 2 ;;
      -A|--add-tag) add_tags="${add_tags:+$add_tags,}$2"; shift 2 ;;
      -D|--delete-tag) delete_tags="${delete_tags:+$delete_tags,}$2"; shift 2 ;;
      -q|--quiet) quiet="$1"; shift ;;
      --or-start) or_start="$1"; shift ;;
      -*) abort 2 "ERR! Unknown option: $1" ;;
      *) id="$1"; shift ;;
    esac
  done

  [ -n "$id" ] || id="$(__battape_tt_query -b , "select id from time_tracker where end = 0 order by start desc limit 1")";

  if [ -z "$id" ] && [ -n "$or_start" ]; then
    __battape_tt_start $quiet --start "$start" --end "$end" --account "$account" --description "$description" --tags "$tags";
    return "$?";
  fi

  [[ "$id" =~ ^[A-HJ-NP-Za-km-z2-9]{10}$ ]] || abort 1 "Usage: tt edit [id] [options]";
  [ -n "$start" ] || start="$(__battape_tt_query -b , "select start from time_tracker where id = '$id'")";
  [ -n "$end" ] || end="$(__battape_tt_query -b , "select end from time_tracker where id = '$id'")";
  [ "$end" -ne 0 ] && [ "$end" -lt "$start" ] && abort 2 "ERR! End time cannot be before start time";

  [ -n "$tags" ] || tags="$(__battape_tt_query -b , "select tags from time_tracker where id = '$id'")";
  [ -n "$delete_tags" ] && tags="$(printf '%s' "$tags" | tr ',' '\n' | awk -v remove=",$delete_tags," 'index(remove, "," $0 ",") == 0 { out = out (out ? "," : "") $0 } END { print out }')";
  [ -n "$add_tags" ] && tags="$tags,$add_tags";
  tags="$(__battape_tt_normalize_tags "$tags")";

  __battape_tt_query <<HERE || return
update time_tracker set
  start = case when $has_start then $start else start end,
  end = case when $has_end then $end else end end,
  account = case when $has_account then '${account//\'/\'\'}' else account end,
  description = case when $has_description then '${description//\'/\'\'}' else description end,
  tags = '$tags'
where id = '$id'
HERE

  [ -n "$quiet" ] || __battape_tt_report --no-footer --id "$id";
}

__battape_tt_report() {
  local start=0 end=0 account tag id limit=1000 footer=1 events total_seconds stats;
  [ -n "$*" ] || start="$(__battape_tt_epoch "-1m")";
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -a|--account) account="${2//\'/\'\'}"; shift 2 ;;
      -t|--tag) tag="${2//\'/\'\'}"; shift 2 ;;
      -s|--start) start="$(__battape_tt_epoch "$2")"; shift 2 ;;
      -e|--end) end="$(__battape_tt_epoch "$2")"; shift 2 ;;
      -l|--limit) limit="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --no-footer) footer=""; shift ;;
      *) abort 2 "ERR! Unknown option: $1" ;;
    esac
  done

  [[ "$start" =~ ^[0-9]+$ ]] || abort 3 "ERR! Invalid --start argument: $start";
  [[ "$end" =~ ^[0-9]+$ ]] || abort 3 "ERR! Invalid --end argument: $end";
  [[ "$limit" =~ ^[0-9]+$ ]] || abort 3 "ERR! Expected a non-negative integer for --limit, got: $limit";
  [[ -z "$id" || "$id" =~ ^[A-HJ-NP-Za-km-z2-9]{10}$ ]] || abort 3 "ERR! Invalid --id argument: $id";
  [ "$end" = 0 ] && end="$(date +"%s")";

  __battape_tt_query <<HERE
select
  id as ID,
  date(start, 'unixepoch', 'localtime') as Date,
  account as Account,
  strftime('%H:%M', start, 'unixepoch', 'localtime') as Start,
  if(end > 0, strftime('%H:%M', end, 'unixepoch', 'localtime'), '-') as Stop,
  format('%sh %sm',
    (if(end > 0, end, strftime('%s')) - start) / 3600,
    ((if(end > 0, end, strftime('%s')) - start) / 60) % 60
  ) as Duration,
  trim(tags, ',') as Tags
  from time_tracker
  where (start >= $start)
    and (start <= $end)
    and (length('$account') = 0 or account = '$account')
    and (length('$tag') = 0 or tags glob '*,$tag,*')
    and (length('$id') = 0 or id = '$id')
  order by time_tracker.start desc
  limit $limit;
HERE

  if [ -n "$footer"  ]; then
    stats=$(__battape_tt_query -b " " "
select count(*), coalesce(sum(if(end > 0, end, strftime('%s')) - start), 0)
  from time_tracker
  where (start >= $start)
    and (start <= $end)
    and (length('$account') = 0 or account = '$account')
    and (length('$tag') = 0 or tags glob '*,$tag,*')
    and (length('$id') = 0 or id = '$id')
") || return;

    read -r events total_seconds <<< "$stats";
    cat <<HERE

  Period:   $(date -r "$start" +%F) -> $(date -r "$end" +%F)
  Account:  ${account:-any}
  Tag:      ${tag:-any}
  Events:   $events
  Total:    $((total_seconds / 3600))h $(((total_seconds / 60) % 60))m

HERE
  fi
}

__battape_tt_commands() {
  local start=0 end=0 account tag id limit=1000 full=0 footer=1 stats event_start event_end commands total_seconds;
  [ -n "$*" ] || id="$(__battape_tt_query -b , "select id from time_tracker order by start desc limit 1")";
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -a|--account) account="${2//\'/\'\'}"; shift 2 ;;
      -t|--tag) tag="${2//\'/\'\'}"; shift 2 ;;
      -s|--start) start="$(__battape_tt_epoch "$2")"; shift 2 ;;
      -e|--end) end="$(__battape_tt_epoch "$2")"; shift 2 ;;
      -l|--limit) limit="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --full) full=1; shift ;;
      --no-footer) footer=""; shift ;;
      *) abort 2 "ERR! Unknown option: $1" ;;
    esac
  done

  [[ "$start" =~ ^[0-9]+$ ]] || abort 3 "ERR! Invalid --start argument: $start";
  [[ "$end" =~ ^[0-9]+$ ]] || abort 3 "ERR! Invalid --end argument: $end";
  [[ "$limit" =~ ^[0-9]+$ ]] || abort 3 "ERR! Expected a non-negative integer for --limit, got: $limit";
  [[ -z "$id" || "$id" =~ ^[A-HJ-NP-Za-km-z2-9]{10}$ ]] || abort 3 "ERR! Invalid --id argument: $id";
  [ "$end" = 0 ] && end="$(date +"%s")";

  # A command belongs to an entry when their execution periods overlap.  This
  # also handles a command which starts before an entry or ends after it.
  if [ "$full" = 1 ]; then
    __battape_tt_query <<HERE
with matching_entries as materialized (
  select start, case when end > 0 then end else strftime('%s') end as end
  from time_tracker
  where start >= $start
    and start <= $end
    and (length('$account') = 0 or account = '$account')
    and (length('$tag') = 0 or tags glob '*,$tag,*')
    and (length('$id') = 0 or id = '$id')
), matching_commands as (
  select distinct h.rowid as history_id, h.start, h.end,
    rtrim(case when instr(h.command, '|') > 0 then substr(h.command, 1, instr(h.command, '|') - 1) else h.command end) as command,
    h.exit_status
  from matching_entries t
  join history h on h.start < t.end and h.end > t.start
)
select
  date(start, 'unixepoch', 'localtime') as Date,
  strftime('%H:%M', start, 'unixepoch', 'localtime') as Start,
  command as Command,
  case when end - start < 60 then format('%ss', end - start)
       else format('%sh %sm', (end - start) / 3600, ((end - start) / 60) % 60) end as Duration,
  exit_status as Exit
from matching_commands
order by start asc
limit $limit;
HERE
  else
    __battape_tt_query <<HERE
with matching_entries as materialized (
  select start, case when end > 0 then end else strftime('%s') end as end
  from time_tracker
  where start >= $start
    and start <= $end
    and (length('$account') = 0 or account = '$account')
    and (length('$tag') = 0 or tags glob '*,$tag,*')
    and (length('$id') = 0 or id = '$id')
), matching_commands as (
  select distinct h.rowid as history_id, h.start, h.end,
    rtrim(case when instr(h.command, '|') > 0 then substr(h.command, 1, instr(h.command, '|') - 1) else h.command end) as command
  from matching_entries t
  join history h on h.start < t.end and h.end > t.start
), command_labels as (
  select
    start,
    end - start as duration,
    case
      when instr(trim(command), ' ') = 0 then trim(command)
      when substr(ltrim(substr(trim(command), instr(trim(command), ' ') + 1)), 1, 1) = '-' then substr(trim(command), 1, instr(trim(command), ' ') - 1)
      else substr(trim(command), 1, instr(trim(command), ' ') - 1) || ' ' ||
        substr(
          ltrim(substr(trim(command), instr(trim(command), ' ') + 1)),
          1,
          case when instr(ltrim(substr(trim(command), instr(trim(command), ' ') + 1)), ' ') = 0
            then length(ltrim(substr(trim(command), instr(trim(command), ' ') + 1)))
            else instr(ltrim(substr(trim(command), instr(trim(command), ' ') + 1)), ' ') - 1 end
        )
    end as command
  from matching_commands
)
select
  count(*) as Runs,
  case when sum(duration) < 60 then format('%ss', sum(duration))
       else format('%sh %sm', sum(duration) / 3600, (sum(duration) / 60) % 60) end as Time,
  command as Command
from command_labels
group by command
order by count(*) desc, max(start) desc, command asc
limit $limit;
HERE
  fi

  if [ -n "$footer" ]; then
    stats=$(__battape_tt_query -b " " <<HERE
with matching_entries as materialized (
  select start, case when end > 0 then end else strftime('%s') end as end
  from time_tracker
  where start >= $start
    and start <= $end
    and (length('$account') = 0 or account = '$account')
    and (length('$tag') = 0 or tags glob '*,$tag,*')
    and (length('$id') = 0 or id = '$id')
), matching_commands as (
  select distinct h.rowid as history_id, h.start, h.end
  from matching_entries t
  join history h on h.start < t.end and h.end > t.start
)
select
  (select min(start) from matching_entries),
  (select max(end) from matching_entries),
  count(*),
  coalesce(sum(end - start), 0)
from matching_commands;
HERE
) || return;

    read -r event_start event_end commands total_seconds <<< "$stats";
    event_start="${event_start:-$start}";
    event_end="${event_end:-$end}";
    cat <<HERE

  Period:    $(date -r "$event_start" +%F) -> $(date -r "$event_end" +%F)
  Account:   ${account:-any}
  Tag:       ${tag:-any}
  Commands:  $commands
  Run time:  $((total_seconds / 3600))h $(((total_seconds / 60) % 60))m

HERE
  fi
}

__battape_tt_setup() {
  mkdir -p "$(dirname "$BATTAPE_DB")" || return;
  sqlite3 -batch -bail -cmd '.timeout 1000' "$BATTAPE_DB" <<'HERE' || return
create table if not exists time_tracker (
  id text primary key not null,
  start integer not null,
  end integer not null,
  hostname text not null,
  user text not null,
  account text not null,
  description text not null,
  tags text not null
);
create index if not exists idx_time_tracker_time on time_tracker(end, start);
create index if not exists idx_time_tracker_account on time_tracker(account);
create index if not exists idx_time_tracker_id on time_tracker(id);
HERE
}

__battape_tt_start() {
  local active; active="$(__battape_tt_query -b , "select id from time_tracker where end = 0 limit 1")";
  [ -z "$active" ] || abort 1 "Did you mean to edit the active entry? Use 'tt edit $*' instead.";

  local start=0 end=0 account description tags quiet;
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -s|--start) start="$(__battape_tt_epoch "$2")"; shift 2 ;;
      -e|--end) end="$(__battape_tt_epoch "$2")"; shift 2 ;;
      -a|--account) account="${2//\'/\'\'}"; shift 2 ;;
      -d|--description) description="${2//\'/\'\'}"; shift 2 ;;
      -t|--tags) tags="$(__battape_tt_normalize_tags "$2")"; shift 2 ;;
      -q|--quiet) quiet=1; shift ;;
      *) abort 2 "ERR! Unknown option: $1" ;;
    esac
  done

  [ -z "$tags" ] && [ -d ".git" ] && tags="$(basename "${PWD//\'/\'\'}")";
  [ -n "$account" ] || account="$(__battape_tt_query -b , "select account from time_tracker where (length('$tags') = 0 or tags glob '*$tags*') or (length('$tags') = 0 and end = 0) order by start desc limit 1")";
  [ -n "$account" ] || abort 1 "Unable to guess --acount from tags '$tags'. Please specify an account with --account.";
  [[ "$start" -gt 0 ]] || start="$(date +%s)";
  [ "$start" -gt "$(date +%s)" ] && abort 2 "ERR! Start time cannot be in the future";
  [[ "$start" =~ ^[0-9]+$ ]] || abort 2 "ERR! Invalid --start argument: $start";
  [[ "$end" =~ ^[0-9]+$ ]] || abort 2 "ERR! Invalid --end argument: $end";
  [ "$end" -ne 0 ] && [ "$end" -lt "$start" ] && abort 2 "ERR! End time cannot be before start time";

  local id; id="$(__battape_tt_id)" || return
  __battape_tt_query <<HERE
insert into time_tracker (id, start, end, hostname, user, account, description, tags) values (
  '$id',
  $start,
  $end,
  '${HOSTNAME//\'/\'\'}',
  '${USER//\'/\'\'}',
  '${account//\'/\'\'}',
  '${description//\'/\'\'}',
  '${tags//\'/\'\'}'
)
HERE

  [ -n "$quiet" ] || __battape_tt_report --limit 1 --id "$id";
}

__battape_tt_help() {
  cat <<'HERE'
Usage: tt [command] [options]

Track time entries in the local battape database.

Commands:
  status                    Show the most recent entries (default).
  edit [id] [options]       Edit the most recent entry or by ID
  start [options]           Start an entry, or update the active entry.
  stop [options]            Stop the active entry.
  report [options]          List matching entries.
  commands [options]        List commands run during matching entries.
  drop <id>                 Interactively delete an entry by its report ID.

Options:
  -h, --help                Show this help text.

Start and stop options:
  -s, --start <time>        Start time (epoch, HH:MM, ISO timestamp, or date offset).
  -e, --end <time>          End time (same formats as --start).
  -a, --account <name>      Account name.
  -d, --description <text>  Entry description.
  -t, --tags <tags>         Space-separated tags.
  -q, --quiet               Do not print the resulting entry.

Edit options:
  -s, --start <time>        Start time (epoch, HH:MM, ISO timestamp, or date offset).
  -e, --end <time>          End time (same formats as --start).
  -a, --account <name>      Account name.
  -d, --description <text>  Entry description.
  -t, --tags <tags>         Space-separated tags.
  -A, --add-tag <tag>       Add a tag
  -D, --delete-tag <tag>    Remove a tag
  -q, --quiet               Do not print the resulting entry.
  --or-start                Start a new entry, unless one is already in action

Drop options:
  --yes                     Do not prompt for confirmation.

Report options:
  -a, --account <name>      Filter by account.
  -t, --tag <tag>           Filter by tag.
  -s, --start <time>        Include entries starting on or before this time.
  -e, --end <time>          Include entries ending on or after this time.
  -l, --limit <number>      Maximum entries to show (default: 1000).

Commands options:
  Same as report, plus:
  --full                    List each complete command invocation.
HERE
}

__battape_tt() {
  local cmd="status";
  [ -n "$1" ] && [[ "$1" != -* ]] && cmd="$1" && shift;
  [ -n "$1" ] && [[ "$1" = *-h* ]] && cmd="help" && shift;
  [ -s "$BATTAPE_DB" ] || __battape_tt_setup;

  case "$cmd" in
    help) __battape_tt_help ;;
    start) __battape_tt_start "$@" ;;
    stop) __battape_tt_edit --end "$(date +%s)" "$@" ;;
    edit) __battape_tt_edit "$@" ;;
    drop) __battape_tt_drop "$@" ;;
    report) __battape_tt_report "$@" ;;
    commands) __battape_tt_commands "$@" ;;
    status) __battape_tt_report --no-footer --start -1d "$@" ;;
    epoch|normalize_tags|id) "__battape_tt_$cmd" "$@" ;; # for testing
    *) echo "Unknown command: $cmd" >&2; return 2 ;;
  esac
}

__battape_tt "$@";
